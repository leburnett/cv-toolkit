# Your CV content stays on your machine. The toolkit is the shared part.
# Both of these start as the tracked .example.md file beside them; copying
# rather than editing in place keeps your name and contact details out of
# git, and stops `git pull` colliding with your own edits.
full_cv.md
cv_template.md
application_log.csv
applications/*
!applications/.gitkeep

# Fonts you embed yourself — licences vary, so they aren't shared by default.
fonts/*.ttf
fonts/*.otf
fonts/fonts.json

# Spreadsheet versions of the log — edit the CSV, not these
*.numbers
*.xlsx
*.xls
*.ods

# Housekeeping
.claude/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
._cv_optimiser_probe.html
